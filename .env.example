# Copy this file to cv-lab/backend/.env (for local runs) and fill in values.
# NEVER commit a real .env — it is gitignored on purpose.

# --- Inference device ---
# auto | cpu | cuda:0
DEVICE=auto

# --- Storage backend ---
# auto | s3 | local   (use "local" for the simplest no-dependencies run)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data

# --- S3 / object store (only needed when STORAGE_BACKEND=s3) ---
# Works with Nutanix Objects, MinIO, AWS S3, or any S3-compatible store.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cvlab
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_VERIFY_SSL=false

# --- LLM endpoint for agentic ops (OPTIONAL) ---
# Any OpenAI-compatible API: Nutanix Enterprise AI (NAI), vLLM, Ollama, OpenAI.
# Leave NAI_BASE_URL blank to disable the LLM and use the deterministic fallback.
NAI_BASE_URL=
NAI_API_KEY=
NAI_MODEL=llama3-1-8b
NAI_VERIFY_SSL=false

# --- Streaming tunables (optional) ---
TARGET_FPS=12
JPEG_QUALITY=70
MAX_STREAM_WIDTH=960
MAX_UPLOAD_MB=200

# --- Models (optional) ---
PERSON_MODEL=yolov8n.pt
# EMPTY_SHELF_MODEL=empty-shelf.pt
# SPILL_MODEL=spill.pt
